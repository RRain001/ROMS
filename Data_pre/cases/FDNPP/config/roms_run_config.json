{
  "launcher": "$HOME/intel/oneapi/mpi/2021.9.0/bin/mpirun",
  "np": 56,
  "shell_init_files": [
    "$HOME/intel/oneapi/setvars.sh"
  ],
  "library_paths": [
    "$HOME/roms_build/install/lib",
    "$HOME/intel/oneapi/compiler/2023.1.0/linux/compiler/lib/intel64_lin"
  ],
  "env": {},
  "build_layout": {
    "build_root": "build",
    "build_dir": "build/Build_romsM",
    "bin_dir": "bin"
  },
  "default_run_mode": "pilot_1day",
  "run_modes": {
    "smoke": {
      "build_variant": "default",
      "binary": "romsM_fdnpp",
      "fallback_binaries": [],
      "infile": "ocean_fdnpp_smoke.in",
      "log_file": "smoke.log"
    },
    "pilot_1day": {
      "build_variant": "default",
      "binary": "romsM_fdnpp",
      "fallback_binaries": [],
      "infile": "ocean_fdnpp_pilot_1day.in",
      "log_file": "pilot_1day.log"
    },
    "pilot_month": {
      "build_variant": "default",
      "binary": "romsM_fdnpp",
      "fallback_binaries": [],
      "infile": "ocean_fdnpp_pilot.in",
      "log_file": "pilot_month.log"
    },
    "online_6h": {
      "build_variant": "online_my25_uvtide",
      "binary": "romsM_fdnpp_online_my25_uvtide",
      "fallback_binaries": [],
      "infile": "ocean_fdnpp_online_6h_online_my25_uvtide.in",
      "log_file": "online_6h.log"
    },
    "online_6h_online_my25_uvtide_decay": {
      "build_variant": "online_my25_uvtide_decay",
      "binary": "romsM_fdnpp_online_my25_uvtide_decay",
      "fallback_binaries": [],
      "infile": "ocean_fdnpp_online_6h_online_my25_uvtide_decay.in",
      "log_file": "online_6h_online_my25_uvtide_decay.log"
    },
    "online_3d": {
      "build_variant": "online_my25_uvtide",
      "binary": "romsM_fdnpp_online_my25_uvtide",
      "fallback_binaries": [],
      "infile": "ocean_fdnpp_online_3d_online_my25_uvtide.in",
      "log_file": "online_3d.log"
    },
    "online_month": {
      "build_variant": "online_my25_uvtide",
      "binary": "romsM_fdnpp_online_my25_uvtide",
      "fallback_binaries": [],
      "infile": "ocean_fdnpp_online_month_online_my25_uvtide.in",
      "log_file": "online_month.log"
    }
  }
}
