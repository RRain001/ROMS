{
  "default_variant": "online_my25_uvtide",
  "formal_online": {
    "mode": "online_continuous_my25_uvtide",
    "variant": "online_my25_uvtide",
    "required_cpp_defs": [
      "SSH_TIDES",
      "UV_TIDES",
      "RAMP_TIDES",
      "TIDES_DATE"
    ]
  },
  "compiler": {
    "fort": "ifort",
    "use_mpi": true,
    "use_mpif90": true,
    "which_mpi": "intel",
    "use_large": true,
    "static": true,
    "exec": true,
    "use_netcdf4": true,
    "use_parallel_io": true,
    "use_debug": false
  },
  "paths": {
    "roms_src": "/home/lhy/ROMS/roms_src/roms",
    "oneapi_setvars": "$HOME/intel/oneapi/setvars.sh",
    "my_local_paths": "$HOME/ROMS/roms_work/my_local_paths.sh",
    "netcdf_root": "$HOME/roms_build/install",
    "hdf5_root": "$HOME/roms_build/install",
    "mpi_root": "$HOME/intel/oneapi/mpi/2021.9.0"
  },
  "build": {
    "build_subdir": "build/Build_romsM",
    "bin_subdir": "bin",
    "jobs": 56,
    "clean_first_default": true
  },
  "variants": {
    "default": {
      "roms_application": "FDNPP_202501",
      "header_dir": "run",
      "analytical_dir": "run",
      "header_name": "fdnpp_202501.h",
      "executable_name": "romsM_fdnpp",
      "fallback_binary_paths": []
    },
    "online_my25_uvtide": {
      "roms_application": "FDNPP_202501_ONLINE_MY25_UVTIDE",
      "header_dir": "run",
      "analytical_dir": "run",
      "header_name": "fdnpp_202501_online_my25_uvtide.h",
      "executable_name": "romsM_fdnpp_online_my25_uvtide",
      "fallback_binary_paths": []
    },
    "online_my25_uvtide_decay": {
      "roms_application": "FDNPP_202501_ONLINE_MY25_UVTIDE_DECAY",
      "header_dir": "run",
      "analytical_dir": "run",
      "header_name": "fdnpp_202501_online_my25_uvtide_decay.h",
      "executable_name": "romsM_fdnpp_online_my25_uvtide_decay",
      "fallback_binary_paths": []
    }
  }
}
