{
  "launcher": "$HOME/intel/oneapi/mpi/2021.9.0/bin/mpirun",
  "np": 4,
  "shell_init_files": [
    "$HOME/intel/oneapi/setvars.sh",
    "${ROMS_NESTING_ROOT}/ROMS_Build/env/linux_intel.sh"
  ],
  "library_paths": [],
  "env": {
    "MPI_ROOT": "$HOME/intel/oneapi/mpi/2021.9.0",
