{
  "default_variant": "default",
  "compiler": {
    "fort": "gfortran",
    "use_mpi": true,
    "use_mpif90": true,
    "which_mpi": "openmpi",
    "use_large": true,
    "static": true,
    "exec": true,
    "use_netcdf4": true,
    "use_parallel_io": false,
    "use_debug": true
  },
  "paths": {
    "roms_src": "${ROMS_NESTING_ROOT}/roms_src/roms",
    "my_local_paths": "${ROMS_NESTING_ROOT}/ROMS_Build/env/macos_gnu_openmpi.sh"
  },
  "build": {
    "build_subdir": "build/Build_romsM",
    "bin_subdir": "bin",
    "jobs": 4,
    "clean_first_default": true,
    "make_variables": {
      "FC": "mpif90"
    }
  },
  "variants": {
    "default": {
      "roms_application": "JAPAN_SEA",
      "header_dir": "run",
      "analytical_dir": "run",
      "header_name": "japan_sea.h",
      "executable_name": "romsM_japan_sea",
      "fallback_binary_paths": []
    }
  },
  "use_legacy_library_paths": false,
  "platform": "Darwin GNU/OpenMPI/Homebrew; unverified on this Linux host"
}
