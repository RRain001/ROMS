  "output": {
    "history_interval_hours": 1,
    "average_interval_hours": 1,
    "diagnostic_interval_hours": 1
  },
  "formal_online_workflow": {
    "enabled": false,
    "profile": "online_my25_uvtide",
    "spinup": {
      "enabled": true,
      "duration_months": 3,
      "source_mode": "zero",
      "history": {
        "enabled": false
      },
      "restart": {
        "enabled": true,
        "interval_days": 5,
        "require_final_restart": true
      },
      "diagnostics": {
        "enabled": false
      }
    },
    "production": {
      "start": "2024-01-01T00:00:00",
      "end": "2025-01-01T00:00:00",
