      "history": {
        "interval_hours": 1,
        "variables": [
          "zeta"
        ]
      },
      "average": {
        "interval_hours": 24,
        "variables": [
          "dye_01",
          "u",
          "v",
          "ubar",
          "vbar"
        ]
      },
      "restart": {
        "interval_days": 5
      },
      "diagnostics": {
        "enabled": false
      }
    }
  },
  "ocean": {
    "default_source": "glorys12v1",
    "time_policy": {
      "source_time_center": "12:00:00",
      "roms_time_policy": "daily_mean_to_day_start"
